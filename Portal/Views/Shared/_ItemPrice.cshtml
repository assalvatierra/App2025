@model Erp.Domain.Models.PortalItemPrice

@if (Model != null)
{
    <div class="card-body">
        <h6 class="card-subtitle mb-2 text-muted"><strong>Pricing</strong></h6>
        <ul class="list-group list-group-flush">
            <li class="list-group-item">
                <div class="d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-currency-dollar"></i> <strong>Base Price:</strong></span>
                    <span class="badge bg-primary rounded-pill">@Model.BasePrice @Model.BaseCurrency / @Model.BaseUnit</span>
                </div>
            </li>
            <li class="list-group-item">
                <div><i class="bi bi-calendar-range"></i> <strong>Valid From:</strong> @Model.ValidFrom.ToString("MMM dd, yyyy")</div>
                <div><i class="bi bi-calendar-check"></i> <strong>Valid To:</strong> @Model.ValidTo.ToString("MMM dd, yyyy")</div>
            </li>
            <li class="list-group-item">
                <div class="d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-info-circle"></i> <strong>Status:</strong></span>
                    @if (Model.Status == "Active")
                    {
                        <span class="badge bg-success">@Model.Status</span>
                    }
                    else if (Model.Status == "Inactive")
                    {
                        <span class="badge bg-secondary">@Model.Status</span>
                    }
                    else
                    {
                        <span class="badge bg-warning">@Model.Status</span>
                    }
                </div>
            </li>
        </ul>
    </div>
}
