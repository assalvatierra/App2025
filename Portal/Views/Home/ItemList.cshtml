@model IEnumerable<Portal.Models.ItemDto>

@{
    ViewData["Title"] = "Search Results";
    var searchTerm = ViewBag.SearchTerm as string;
}

<div class="container my-5">
    <div class="row">
        <div class="col-md-12">
            <h1 class="mb-4">@ViewBag.PageTitle</h1>

            @if (!string.IsNullOrWhiteSpace(ViewBag.PageMessage as string))
            {
                <p class="lead">@ViewBag.PageMessage</p>
            }

            <!-- Back to Search Button -->
            <div class="mb-3">
                <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Back to Home
                </a>
            </div>

            @if (Model != null && Model.Any())
            {
                <div class="alert alert-success" role="alert">
                    Found @Model.Count() item(s)
                </div>

                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                    @foreach (var item in Model)
                    {
                        <div class="col">
                            <div class="card h-100 shadow-sm">
                                <div class="card-body">
                                    <img src="@item.ImageUrl" alt="@item.PortalItem.Name rental car available" loading="lazy">

                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <h5 class="card-title mb-0">@item.Title</h5>
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(item.Description))
                                    {
                                        <p class="card-text text-muted">@item.Description</p>
                                    }

                                    <!--
                                    <div class="mt-3">
                                        @if (item.PortalItem.SortOrder.HasValue)
                                        {
                                            <small class="text-muted d-block">Order: @item.PortalItem.SortOrder</small>
                                        }
                                        <small class="text-muted d-block">
                                            Status: 
                                            @if (item.PortalItem.IsActive)
                                            {
                                                <span class="badge bg-success">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Inactive</span>
                                            }
                                        </small>
                                    </div>
                                    -->
                                </div>

                                <!-- Section: Specifications -->
                                @await Html.PartialAsync("_ItemSpecifications_CarRental", item.PortalItem.PortalItemSpecs)

                                <!-- Section: Footer -->
                                <div class="card-footer bg-transparent d-flex justify-content-between align-items-center">
                                    <a asp-controller="PortalReservation" 
                                       asp-action="ReservationForm" 
                                       asp-route-itemId="@item.PortalItem.Id"
                                       class="btn btn-sm btn-primary">
                                        <i class="bi bi-calendar-check"></i> Reserve
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-info" role="alert">
                    <h4 class="alert-heading">No Results Found</h4>
                    <p>No items matched your search criteria. Please try a different search term.</p>
                    <hr>
                    <p class="mb-0">
                        <a asp-controller="Home" asp-action="Index" class="alert-link">Try another search</a>
                    </p>
                </div>
            }
        </div>
    </div>
</div>

<!-- Additional styles for better card presentation -->
<style>
    .card {
        transition: transform 0.2s, box-shadow 0.2s;
    }

    .card:hover {
        transform: translateY(-5px);
        box-shadow: 0 4px 15px rgba(0,0,0,0.2) !important;
    }

    .card-title {
        color: #2c3e50;
        font-weight: 600;
    }

    .badge {
        font-size: 0.75rem;
        padding: 0.35em 0.65em;
    }
</style>
